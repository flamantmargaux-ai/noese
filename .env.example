# Copiez ce fichier en .env et complétez-le. Ne versionnez jamais .env.

# Fournisseur de modèles : toute API compatible OpenAI hébergée dans l'UE.
# Mistral (par défaut)
NOESE_LLM_BASE_URL=https://api.mistral.ai/v1
NOESE_LLM_API_KEY=
NOESE_LLM_CHAT_MODEL=mistral-small-latest
# « local » : embeddings lexicaux calculés sur place, sans appel externe.
# Mettez mistral-embed (ou le modèle d'embeddings de votre fournisseur) si votre offre le permet.
NOESE_LLM_EMBED_MODEL=mistral-embed
NOESE_LLM_STT_MODEL=voxtral-mini-latest
NOESE_EMBED_DIM=1024

# API Albert (État) : décommentez et adaptez.
# NOESE_LLM_BASE_URL=https://albert.api.etalab.gouv.fr/v1
# NOESE_LLM_API_KEY=
# NOESE_LLM_CHAT_MODEL=
# NOESE_LLM_EMBED_MODEL=

# Modèle auto-hébergé (vLLM, Ollama…) : même principe.
# NOESE_LLM_BASE_URL=http://mon-serveur:8000/v1

# Premier référent de la base : il reçoit son lien de connexion à cette adresse.
# Les autres référents s'ajoutent ensuite dans les Paramètres.
NOESE_REFERENT_BASE_EMAIL=

# Secret de signature des liens magiques et des sessions : une longue chaîne aléatoire.
NOESE_SECRET=
NOESE_BASE_URL=http://localhost:8000

# Envoi des mails (SMTP de la collectivité)
NOESE_SMTP_HOST=localhost
NOESE_SMTP_PORT=1025
NOESE_SMTP_USER=
NOESE_SMTP_PASSWORD=
NOESE_SMTP_FROM=noese@ville.fr
